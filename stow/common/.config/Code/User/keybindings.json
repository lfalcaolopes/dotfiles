// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "ctrl+abnt_c1",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },

  // NAVIGATION

  {
    "key": "ctrl+t",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+k",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+n",
    "command": "workbench.action.terminal.new",
    "when": "terminalFocus"
  },

  // FILE TREE
  {
    "key": "ctrl+e",
    "command": "workbench.view.explorer",
    "when": "!explorerViewletFocus"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "explorerViewletFocus"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
        "text": "\u001b\r"
    },
    "when": "terminalFocus"
},


  // --- EXPLORER: motions ---
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "g g",
    "command": "list.focusFirst",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+g",
    "command": "list.focusLast",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "ctrl+d",
    "command": "list.focusPageDown",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "ctrl+u",
    "command": "list.focusPageUp",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "o",
    "command": "list.select",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "z a",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "z m",
    "command": "list.collapseAll",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "s",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && !inputFocus"
  },

  // --- EXPLORER: operacoes ---
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceReadonly"
  },
  {
    "key": "shift+a",
    "command": "explorer.newFolder",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceReadonly"
  },
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceReadonly"
  },
  {
    "key": "d d",
    "command": "moveFileToTrash",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceReadonly"
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceReadonly"
  },
  {
    "key": "y y",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceReadonly"
  },
  {
    "key": "y p",
    "command": "copyRelativeFilePath",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+r",
    "command": "workbench.files.action.refreshFilesExplorer",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "q",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "u",
    "command": "undo",
    "when": "filesExplorerFocus && !inputFocus"
  },


  // --- BUSCA: motions ---
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "g g",
    "command": "list.focusFirst",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "shift+g",
    "command": "list.focusLast",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "ctrl+d",
    "command": "list.focusPageDown",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "ctrl+u",
    "command": "list.focusPageUp",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "z m",
    "command": "search.action.collapseSearchResults",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "z r",
    "command": "search.action.expandSearchResults",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },

  // --- BUSCA: operacoes ---
  {
    "key": "i",
    "command": "workbench.action.findInFiles",
    "when": "fileMatchOrMatchFocus && !inputBoxFocus"
  },
  {
    "key": "escape",
    "command": "search.action.focusSearchList",
    "when": "searchViewletVisible && searchInputBoxFocus"
  },


  // --- TERMINAL ---
  {
    "key": "ctrl+shift+x",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+u",
    "command": "workbench.action.terminal.scrollUpPage",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+d",
    "command": "workbench.action.terminal.scrollDownPage",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+g",
    "command": "workbench.action.terminal.scrollToBottom",
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+r",
    "command": "workbench.action.terminal.runRecentCommand",
    "when": "terminalFocus"
  },


  // --- SOURCE CONTROL ---
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "g g",
    "command": "list.focusFirst",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "shift+g",
    "command": "list.focusLast",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "ctrl+d",
    "command": "list.focusPageDown",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "ctrl+u",
    "command": "list.focusPageUp",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "s",
    "command": "git.stage",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "u",
    "command": "git.unstage",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "shift+x",
    "command": "git.clean",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },
  {
    "key": "c",
    "command": "workbench.scm.focus",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm' && listFocus && !inputFocus"
  },

  // --- PROBLEMAS ---
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },
  {
    "key": "g g",
    "command": "list.focusFirst",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },
  {
    "key": "shift+g",
    "command": "list.focusLast",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },
  {
    "key": "ctrl+d",
    "command": "list.focusPageDown",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },
  {
    "key": "ctrl+u",
    "command": "list.focusPageUp",
    "when": "focusedView == 'workbench.panel.markers.view' && !inputFocus"
  },

  // --- QUICK OPEN E AUTOCOMPLETE ---
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible && textInputFocus"
  },

  // === WIDGET DE DIAGNOSTICOS (]d / [d) ===
  {
    "key": "ctrl+j",
    "command": "editor.action.marker.next",
    "when": "markersNavigationVisible && editorFocus"
  },
  {
    "key": "ctrl+k",
    "command": "editor.action.marker.prev",
    "when": "markersNavigationVisible && editorFocus"
  },
  {
    "key": "escape",
    "command": "closeMarkersNavigation",
    "when": "markersNavigationVisible && editorFocus"
  }
]
